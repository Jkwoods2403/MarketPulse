          "status",
          "reason",
          "methodology",
          "current",
          "comparison",
          "absolute_change",
          "change_units",
          "basis_points",
          "percent_change",
          "percent_note",
          "window",
          "minimum",
          "maximum",
          "position_percent",
          "position"
