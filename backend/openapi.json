          }
        },
        "type": "object",
        "required": [
          "status",
          "reference_date",
          "latest_period_end",
          "age_days",
          "max_staleness_days"
        ],
        "title": "Freshness",
        "description": "Whether newer data should exist, judged from the latest period's end date.\n\n`fresh`: the latest period ended no more than `max_staleness_days` before\n`reference_date`. `stale`: longer ago. `unavailable`: nothing stored."
      },
