      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Body of a 404 or 503 answer. Unknown and not-permitted series get the same 404."
      },
      "Freshness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
