# Normalize line endings: LF in the repository and working tree, on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never diff or normalize.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.pdf     binary
*.parquet binary
*.gz      binary
*.zip     binary

# Recorded provider responses are verified by SHA-256: keep them byte-for-byte as recorded.
backend/tests/fixtures/** -text
