# =============================================================================
# Market Pulse environment variables
# Copy to `.env` and fill in values:  cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# =============================================================================

# --- Application ---------------------------------------------------------------
# One of: development, test, staging, production
MARKETPULSE_ENV=development
# One of: DEBUG, INFO, WARNING, ERROR
MARKETPULSE_LOG_LEVEL=INFO
# Where raw provider payloads are stored (default: <repo>/data). Always gitignored.
MARKETPULSE_DATA_DIR=

# --- PostgreSQL (local Docker Compose) -----------------------------------------
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marketpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Data provider API keys (added as connectors are built) ----------------------
# EIA:   https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# FRED:  https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# ERCOT: https://apiexplorer.ercot.com/
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=
# SEC EDGAR and NWS require a descriptive User-Agent with contact info, not a key.
# Example: "MarketPulse/0.1 (you@example.com)"
HTTP_USER_AGENT=

# --- Frontend ----------------------------------------------------------------------
# Server-side only: the Next.js server calls the API at this URL.
MARKETPULSE_API_URL=http://localhost:8000
